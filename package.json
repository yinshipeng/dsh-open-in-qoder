{
  "name": "dsh-open-in-qoder",
  "version": "0.1.0",
  "description": "Opens the current DSH conversation workspace in Qoder CN IDE from a button in the conversation header, for Hosts whose shipped Open In... catalog has no such entry.",
  "type": "module",
  "license": "MIT",
  "author": "yinshipeng <yinshipeng@126.com>",
  "homepage": "https://github.com/yinshipeng/dsh-open-in-qoder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinshipeng/dsh-open-in-qoder.git"
  },
  "bugs": {
    "url": "https://github.com/yinshipeng/dsh-open-in-qoder/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "qoder",
    "qoder-cn",
    "ide",
    "open-in-app",
    "macos"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}